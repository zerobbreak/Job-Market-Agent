# LLM API Keys (One is required)
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Auth is handled by fastapi-users (see SECRET_KEY below) — no external
# auth provider needed.

# Database (Postgres)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# File storage — a local directory, ideally a mounted persistent volume
# (e.g. a Railway Volume) in production.
STORAGE_VOLUME_PATH=storage

# Public base URL this API is reachable at (used to build signed file URLs).
API_BASE_URL=http://localhost:8000

# Job Search Defaults
CV_FILE_PATH=cvs/CV.pdf
SEARCH_QUERY=Python Developer
LOCATION="South Africa"
MAX_JOBS=10

# Server Configuration
ENVIRONMENT=development
DEBUG=True
# Signs auth JWTs and password-reset/verification tokens (fastapi-users) —
# generate a real random value, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
SECRET_KEY=generate_a_strong_random_string_here
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
PORT=8000
SIGNED_URL_SECRET=optional_separate_secret_for_urls
SIGNED_URL_EXPIRY_SECONDS=3600

# Scraping & Caching Settings
SCRAPER_CACHE_DIR=job_cache
CACHE_MAX_AGE_HOURS=24
CACHE_MAX_SIZE_MB=100
DEFAULT_RESULTS_WANTED=20
MAX_WORKERS=5
API_MAX_RETRIES=3
API_RETRY_DELAY=2.0
API_TIMEOUT=30
